<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="0.2.0-preview" />
  <PropertyGroup>
    <Name>Mst.Integration</Name>
    <ProjectGuid>{594C0AE6-31CF-45FB-BA8F-46ECF885E9C0}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Mst.Integration.Database.publish.xml" />
  </ItemGroup>
  <ItemGroup>
    <PreDeploy Include="Script.PreDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="Script.PostDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <SqlCmdVariable Include="LoadTestSeedData">
      <Value>$(SqlCmdVar__1)</Value>
      <DefaultValue>N</DefaultValue>
    </SqlCmdVariable>
  </ItemGroup>
  <ItemGroup>
    <Build Remove="Table\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Integration" />
    <Folder Include="Integration\Seed" />
    <Folder Include="Integration\Tables" />
    <Folder Include="Integration\Schema.sql" />
    <Folder Include="Tables" />
    <Folder Include="Views" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Integration\Seed\**" />
  </ItemGroup>


  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>