{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Identity Service (mst)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/services/Identity/Mst.Identity.Services.API/bin/Debug/net9.0/Mst.Identity.Services.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/Identity/Mst.Identity.Services.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
